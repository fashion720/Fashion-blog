---
import { getSiteSettings, getAllPages } from '../lib/keystatic-reader';

const currentYear = new Date().getFullYear();

// Admin Panel se dynamic Settings aur saare Pages fetch kar rahe hain
const settings = await getSiteSettings();
const allPages = await getAllPages();

// Default values backup ke liye agar panel khali ho
const footerDesc =
  settings?.footerDescription ||
  "Premium editorial content exploring contemporary fashion, timeless style, and cultural trends. Curated for the discerning reader.";

const siteName = settings?.siteName || "FASHION EDITORIAL";
---

<footer class="bg-black text-white mt-20 md:mt-24 py-12 md:py-20 antialiased w-full max-w-full block overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full block box-border">

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10 md:gap-12 mb-12 md:mb-16 w-full text-left">

      <!-- Site Description -->
      <div class="min-w-0 w-full block break-words">
        <h3 class="text-xs md:text-sm font-medium tracking-[0.2em] uppercase mb-4 md:mb-6 text-white truncate">
          {siteName}
        </h3>

        <p class="text-xs md:text-sm text-neutral-400 font-light leading-relaxed break-words">
          {footerDesc}
        </p>
      </div>

      <!-- Explore -->
      <div class="min-w-0 w-full block">
        <h4 class="text-[10px] md:text-xs font-bold tracking-widest text-neutral-400 uppercase mb-4 md:mb-6 border-b border-neutral-900 pb-3 md:pb-4 truncate">
          EXPLORE
        </h4>

        <ul class="space-y-3 md:space-y-4 text-xs md:text-sm block">
          <li>
            <a
              href="/"
              class="text-neutral-300 hover:text-white transition-colors duration-300 font-light no-underline block"
            >
              Home
            </a>
          </li>

          <li>
            <a
              href="/categories"
              class="text-neutral-300 hover:text-white transition-colors duration-300 font-light no-underline block"
            >
              Categories
            </a>
          </li>

          <li>
            <a
              href="/posts"
              class="text-neutral-300 hover:text-white transition-colors duration-300 font-light no-underline block"
            >
              Blog
            </a>
          </li>
        </ul>
      </div>

      <!-- Information -->
      <div class="min-w-0 w-full block">
        <h4 class="text-[10px] md:text-xs font-bold tracking-widest text-neutral-400 uppercase mb-4 md:mb-6 border-b border-neutral-900 pb-3 md:pb-4 truncate">
          INFORMATION
        </h4>

        <ul class="space-y-3 md:space-y-4 text-xs md:text-sm block">

          {settings?.showAboutUsPage !== false && (
            <li class="block truncate">
              <a
                href="/about"
                class="text-neutral-300 hover:text-white transition-colors duration-300 font-light no-underline block truncate"
              >
                About Us
              </a>
            </li>
          )}

          {settings?.showContactUsPage !== false && (
            <li class="block truncate">
              <a
                href="/contact"
                class="text-neutral-300 hover:text-white transition-colors duration-300 font-light no-underline block truncate"
              >
                Contact Us
              </a>
            </li>
          )}

          {settings?.showPrivacyPolicyPage !== false && (
            <li class="block truncate">
              <a
                href="/privacy-policy"
                class="text-neutral-300 hover:text-white transition-colors duration-300 font-light no-underline block truncate"
              >
                Privacy Policy
              </a>
            </li>
          )}

          {settings?.showDisclaimerPage !== false && (
            <li class="block truncate">
              <a
                href="/disclaimer"
                class="text-neutral-300 hover:text-white transition-colors duration-300 font-light no-underline block truncate"
              >
                Disclaimer
              </a>
            </li>
          )}

          {allPages &&
            allPages.length > 0 &&
            allPages.map((page) => {
              const displayTitle = page.entry?.title
                ? page.entry.title
                : page.slug.replace(/-/g, ' ');

              return (
                <li class="block truncate">
                  <a
                    href={`/${page.slug}`}
                    class="text-neutral-300 hover:text-white transition-colors duration-300 font-light no-underline block capitalize truncate"
                  >
                    {displayTitle}
                  </a>
                </li>
              );
            })}
        </ul>
      </div>

    </div>

    <!-- Social Icons -->
    <div class="flex items-center justify-center gap-6 mb-8 md:mb-10 w-full">
      {settings?.showPinterest !== false && settings?.pinterestUrl && (
        <a href={settings.pinterestUrl} target="_blank" rel="noopener noreferrer" aria-label="Pinterest" class="text-neutral-400 hover:text-white transition-colors duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.123.348 2.317.535 3.554.535 6.627 0 12-5.373 12-12C24 5.372 18.627 0 12 0z"/></svg>
        </a>
      )}

      {settings?.showFacebook !== false && settings?.facebookUrl && (
        <a href={settings.facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-neutral-400 hover:text-white transition-colors duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24h-1.918c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.407 24 24 23.407 24 22.676V1.325C24 .593 23.407 0 22.675 0z"/></svg>
        </a>
      )}

      {settings?.showTwitter !== false && settings?.twitterUrl && (
        <a href={settings.twitterUrl} target="_blank" rel="noopener noreferrer" aria-label="X" class="text-neutral-400 hover:text-white transition-colors duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      )}

      {settings?.contactEmail && (
        <a href={`mailto:${settings.contactEmail}`} aria-label="Email" class="text-neutral-400 hover:text-white transition-colors duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z" stroke="none"/><path d="M22 6l-10 7L2 6"/><path d="M2 6h20v12H2z"/></svg>
        </a>
      )}
    </div>

    <!-- Trust Line -->
    <p class="text-center text-[11px] text-neutral-500 font-light mb-8 md:mb-10 px-4">
      Every article on {siteName} is fact-checked, reviewed for accuracy, and carefully proofread before it goes live!
    </p>

    <!-- Bottom Border -->
    <div class="border-t border-neutral-900 my-8 md:my-12 w-full block"></div>

    <!-- Copyright -->
    <div class="text-center w-full block">
      <p class="text-xs text-neutral-500 font-light tracking-wide break-words">
        &copy; {currentYear} {siteName}. All rights reserved.
      </p>
    </div>

  </div>
</footer>
