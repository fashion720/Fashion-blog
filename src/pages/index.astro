---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';
import PostCard from '../components/PostCard.astro';
import CompactPostRow from '../components/CompactPostRow.astro';
import {
  getAllPosts,
  getAllCategories,
  getPostsByCategory,
  getSiteSettings,
} from '../lib/keystatic-reader';

const settings = await getSiteSettings();
const allCategories = await getAllCategories();

// MONETIZATION CONFIGURATION
const isMonetized = settings.adsenseEnabled === true && Boolean(settings.adSlotHeader || settings.adSlotContent || settings.adSlotFooter);

async function getPostImage(post: any) {
  const rawContent = (await post.entry.content()) as string;
  if (!rawContent) return '/images/placeholder.jpg';
  if (post.entry.sections && post.entry.sections[0]?.image) {
    const img = post.entry.sections[0].image;
    return img.startsWith('/') ? img : `/images/posts/${img}`;
  }
  const match = rawContent.match(/!\[.*?\]\((.*?)\)/);
  if (match && match[1]) {
    return match[1].trim();
  }
  return '/images/placeholder.jpg';
}

async function getPostDescription(post: any, length = 140) {
  const rawContent = (await post.entry.content()) as string;
  if (!rawContent) return 'Explore contemporary style and curated fashion insights inside this editorial.';
  const cleanText = rawContent
  .replace(/!\[([^\]]*)\]\([^)]+\)/g, '')
.replace(/[#*_`~]/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/^[-\s]*\n/gm, '')
    .trim();
  return cleanText.length > length ? `${cleanText.substring(0, length)}...` : cleanText;
}

async function resolvePosts(posts: any[], descLength = 120) {
  return Promise.all(
    posts.map(async (post) => {
      const dynamicDesc = await getPostDescription(post, descLength);
      const dynamicImg = await getPostImage(post);
      return { ...post, dynamicDesc, dynamicImg };
    })
  );
}

const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const categoryLabel = (slug: string) =>
  allCategories.find((c) => c.slug === slug)?.entry.name || slug.replace(/-/g, ' ');

const allPosts = await getAllPosts();
const usedSlugs = new Set<string>();

function take(posts: any[], count: number) {
  const picked = posts.filter((p) => !usedSlugs.has(p.slug)).slice(0, count);
  picked.forEach((p) => usedSlugs.add(p.slug));
  return picked;
}

const flagship = take(allPosts, 1)[0];

const editorSupportingRaw: any[] = [];
const seenParents = new Set<string>();
for (const post of allPosts) {
  if (usedSlugs.has(post.slug) || editorSupportingRaw.length >= 3) continue;
  const primaryCat = post.entry.categories?.[0];
  const parentSlug =
    allCategories.find((c) => c.slug === primaryCat)?.entry.parentCategory || primaryCat;
  if (parentSlug && seenParents.has(parentSlug)) continue;
  if (parentSlug) seenParents.add(parentSlug);
  editorSupportingRaw.push(post);
}
editorSupportingRaw.forEach((p) => usedSlugs.add(p.slug));

const flagshipResolved = flagship
  ? { ...flagship, dynamicDesc: await getPostDescription(flagship, 160), dynamicImg: await getPostImage(flagship) }
  : null;
const editorSupporting = await resolvePosts(editorSupportingRaw, 90);

const latestPosts = await resolvePosts(take(allPosts, 6), 110);

const mensPostsRaw = await getPostsByCategory('mens-fashion');
const mensPosts = await resolvePosts(take(mensPostsRaw, 4), 100);

const womensPostsRaw = await getPostsByCategory('womens-fashion');
const womensPosts = await resolvePosts(take(womensPostsRaw, 4), 100);

const trendSlugs = ['trends-and-aesthetics'];
const trendPostsRaw = (
  await Promise.all(trendSlugs.map((s) => getPostsByCategory(s)))
).flat();
const trendPostsDeduped = trendPostsRaw.filter(
  (post, idx, arr) => arr.findIndex((p) => p.slug === post.slug) === idx
);
const trendPosts = await resolvePosts(take(trendPostsDeduped, 4), 100);

const readerFavorites = await resolvePosts(take(allPosts, 5), 90);

async function discoveryCard(categorySlug: string, label: string, description: string, href: string) {
  const posts = await getPostsByCategory(categorySlug);
  const img = posts[0] ? await getPostImage(posts[0]) : '/images/placeholder.jpg';
  return { label, description, href, img };
}

const discoveryCards = await Promise.all([
  discoveryCard('mens-fashion', "Men's Style", 'Outfit inspiration, wardrobe ideas, and style guides for men.', '/category/mens-fashion/'),
  discoveryCard('womens-fashion', "Women's Style", 'Easy outfit ideas, seasonal looks, and styling inspiration for women.', '/category/womens-fashion/'),
  discoveryCard('trends-and-aesthetics', 'Fashion Trends', 'Discover the aesthetics, pieces, and trends everyone is talking about.', '/category/trends-and-aesthetics/'),
  discoveryCard('diy-and-upcycling', 'DIY & Upcycling', 'Creative ways to restyle, customize, and give old clothes a second life.', '/category/diy-and-upcycling/'),
  discoveryCard('accessories-and-footwear', 'Accessories & Footwear', 'Sneakers, bags, jewelry, and the finishing touches that complete a look.', '/category/accessories-and-footwear/'),
]);

const faqItems = [
  {
    question: 'How do I use the guides on Outfit Edits?',
    answer: 'Start with the category that matches what you are dressing for — Men’s Style, Women’s Style, Trends & Aesthetics, Campus Style, Denim & Basics, DIY & Upcycling, or Accessories & Footwear — then pick a guide and follow its principle first. Each guide names the pieces, proportions, and layering order, so you can adapt it to your own style, occasion, and wardrobe instead of copying it exactly.',
  },
  {
    question: 'Do I need to buy new clothes to follow the looks?',
    answer: 'No. Many guides are built around pieces you already own, and the fall guide built on that idea needs no new purchases. Its fifteen ideas mix textures, layer basics, and adjust proportions so your current wardrobe feels new for the season, while keeping budget and sustainability goals in mind.',
  },
  {
    question: 'What does Outfit Edits cover?',
    answer: 'Outfit ideas, seasonal styling guides, trend coverage, and practical how-tos for everyday wardrobes, across seven categories: Men’s Style, Women’s Style, Trends & Aesthetics, Denim & Basics, Campus Style, DIY & Upcycling, and Accessories & Footwear.',
  },
  {
    question: 'How often are new guides published?',
    answer: "The site does not state a fixed publishing schedule, so the best way to see what is new is the Latest Posts section on this page, which lists the most recent guides first. Editor's Picks, at the top of the page, highlights the current selection the editor wants you to start with.",
  },
  {
    question: 'Do the guides work for work, class, and everyday occasions?',
    answer: 'Yes. The guides are written for real occasions: workdays, meetings, and smart lunches; classes and campus life; and weekends, travel, parties, and snow days. Each guide says what the look is for, so pick the occasion first and then the layering, fit, and finishing touches that suit it.',
  },
  {
    question: 'How can I keep up with new outfit ideas?',
    answer: 'Check Latest Posts on this page for the newest guides, and use the newsletter section below to get outfit ideas, fashion trends, and style inspiration delivered to your inbox. You can also browse by category — for example, Trends & Aesthetics for what is current, or Denim & Basics for the foundations that change least.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title={`${settings.siteName} — Style That Fits Your Life`}
  modifiedTime={flagship?.entry.updatedDate || new Date().toISOString()}
>
  <Header currentPath="/" />

  <main class="bg-[#F8F6F2] min-h-screen font-sans antialiased text-neutral-900 w-full overflow-x-hidden">

    <section class="hero-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 md:pt-12 pb-12 md:pb-16" data-hero-parallax>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-8 lg:gap-10 min-[1440px]:gap-14 items-center">
        <div class="order-2 lg:order-1 text-left space-y-6 md:space-y-7" data-hero-copy>
          <span class="inline-block text-[10px] font-bold uppercase tracking-[0.35em] text-[#bba15c]">
            Outfit Edits — New Season Edit
          </span>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif font-light tracking-tight text-neutral-950 leading-[1.05]">
            Style That Fits Your Life.
          </h1>
          <p class="text-neutral-500 text-sm md:text-base leading-relaxed max-w-md font-light">
            Discover outfit ideas, fashion trends, and practical style inspiration for every day, every season, and every occasion.
          </p>
          <div class="flex flex-wrap items-center gap-4 md:gap-6 pt-2">
            <a href="/posts/" class="inline-block bg-neutral-950 text-white text-[11px] uppercase tracking-[0.2em] font-medium px-7 py-4 hover:bg-[#bba15c] transition-colors duration-300 no-underline">
              Explore Outfit Ideas
            </a>
            <a href="/category/trends-and-aesthetics/" class="inline-block text-[11px] uppercase tracking-[0.2em] font-medium text-neutral-950 border-b border-neutral-950/30 pb-1 hover:text-[#bba15c] hover:border-[#bba15c] transition-colors duration-300 no-underline">
              Latest Trends →
            </a>
          </div>
        </div>
        {flagshipResolved && (
          <div class="hero-image-wrap order-1 lg:order-2 w-full aspect-[4/5] bg-white p-2 md:p-3 border border-neutral-200/30 shadow-sm relative overflow-hidden group" data-hero-image>
            <a href={`/posts/${flagshipResolved.slug}/`} class="absolute inset-0 w-full h-full block">
              <img
                src={flagshipResolved.dynamicImg}
                alt={flagshipResolved.entry.title}
                data-pin-nopin="true"
                loading="eager"
                fetchpriority="high"
                class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-103"
                onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
              />
            </a>
          </div>
        )}
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
      <div class="text-center mb-8 md:mb-12 space-y-2">
        <h2 class="text-2xl md:text-3xl font-serif font-light tracking-tight text-neutral-950">
          Where Would You Like to Start?
        </h2>
        <div class="w-12 h-[1px] bg-[#bba15c] mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-6">
        {discoveryCards.map((card) => (
          <a href={card.href} class="group relative block w-full aspect-[3/4] overflow-hidden no-underline bg-neutral-900">
            <img
              src={card.img}
              alt={card.label}
              loading="lazy"
              data-pin-nopin="true"
              class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5 md:p-7 text-left">
              <h3 class="text-white text-lg md:text-xl font-serif font-light tracking-tight mb-1.5 group-hover:text-[#e8d5a3] transition-colors duration-300">
                {card.label}
              </h3>
              <p class="text-white/70 text-[11px] md:text-xs font-light leading-relaxed max-w-[220px]">
                {card.description}
              </p>
              <span class="inline-block mt-3 text-[10px] uppercase tracking-[0.25em] text-white/90 border-b border-white/40 pb-0.5 group-hover:border-[#bba15c] group-hover:text-[#e8d5a3] transition-colors duration-300">
                Discover
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="max-w-2xl mx-auto px-4 sm:px-6 text-center pb-16 md:pb-24">
      <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-[#bba15c] mb-4">
        Make Getting Dressed Easier
      </p>
      <p class="text-lg md:text-2xl font-serif font-light text-neutral-800 leading-relaxed">
        Outfit Edits brings together wearable outfit ideas, useful style guides, seasonal inspiration, and fashion trends — so you can spend less time wondering what to wear and more time feeling good in what you choose.
      </p>
    </section>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-16 md:pb-24">
      <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.3em] text-[#bba15c]">What We Cover</p>
      <h2 class="font-serif text-3xl font-light text-neutral-950 md:text-4xl">What Outfit Edits covers</h2>
      <div class="mt-7 space-y-5 text-base font-light leading-relaxed text-neutral-600 md:text-lg">
        <p>Outfit Edits is a fashion and style publication for everyday wardrobes. Its guides cover outfit ideas, seasonal styling, trend coverage, and practical how-tos, and each one is built around wearable ideas readers can adapt to their own style, occasion, and wardrobe. Start with the area that matches what you are dressing for, and try the ideas first with clothes you already have.</p>
      </div>
      <div class="mt-10 space-y-8">
        <div>
          <h3 class="font-serif text-xl font-light text-neutral-950"><a href="/category/mens-fashion/" class="no-underline text-neutral-950 hover:text-[#bba15c] transition-colors">Men's Style</a></h3>
          <p class="mt-2 text-sm font-light leading-relaxed text-neutral-500">Men's fashion guides and outfit ideas for every season: jackets, layering, smart casual looks, and timeless staples styled for college, work, and weekends.</p>
        </div>
        <div>
          <h3 class="font-serif text-xl font-light text-neutral-950"><a href="/category/womens-fashion/" class="no-underline text-neutral-950 hover:text-[#bba15c] transition-colors">Women's Style</a></h3>
          <p class="mt-2 text-sm font-light leading-relaxed text-neutral-500">Outfit inspiration, dresses, casual looks, workwear, and accessories, with seasonal looks and styling ideas for women. The guides name the pieces and the layering order, so you can follow a look for work, a dinner out, or an ordinary day.</p>
        </div>
        <div>
          <h3 class="font-serif text-xl font-light text-neutral-950"><a href="/category/trends-and-aesthetics/" class="no-underline text-neutral-950 hover:text-[#bba15c] transition-colors">Trends &amp; Aesthetics</a></h3>
          <p class="mt-2 text-sm font-light leading-relaxed text-neutral-500">Current trends, aesthetics, viral fashion moments, and seasonal style ideas, with the context to decide what fits your own style. Read a trend guide to understand the look first, then keep only the pieces or proportions that work with clothes you already own.</p>
        </div>
        <div>
          <h3 class="font-serif text-xl font-light text-neutral-950"><a href="/category/denim-and-basics/" class="no-underline text-neutral-950 hover:text-[#bba15c] transition-colors">Denim &amp; Basics</a></h3>
          <p class="mt-2 text-sm font-light leading-relaxed text-neutral-500">Build a wardrobe on strong foundations: denim fits, basic tees, layering pieces, and timeless staples styled in fresh combinations for easy everyday wear. When an outfit feels stuck, return to these basics and change one thing — the fit, the layer, or the shoes — before adding anything new.</p>
        </div>
        <div>
          <h3 class="font-serif text-xl font-light text-neutral-950"><a href="/category/campus-style/" class="no-underline text-neutral-950 hover:text-[#bba15c] transition-colors">Campus Style</a></h3>
          <p class="mt-2 text-sm font-light leading-relaxed text-neutral-500">Practical, stylish outfit ideas for college and high school life, from first-day looks and classroom layering to game-day outfits and campus-ready essentials.</p>
        </div>
        <div>
          <h3 class="font-serif text-xl font-light text-neutral-950"><a href="/category/diy-and-upcycling/" class="no-underline text-neutral-950 hover:text-[#bba15c] transition-colors">DIY &amp; Upcycling</a></h3>
          <p class="mt-2 text-sm font-light leading-relaxed text-neutral-500">Creative ways to restyle, customize, and give old clothes a second life, including ideas that need no sewing machine. Start with a piece you already own and change its shape, length, or surface before you decide whether it still earns a place in your wardrobe.</p>
        </div>
        <div>
          <h3 class="font-serif text-xl font-light text-neutral-950"><a href="/category/accessories-and-footwear/" class="no-underline text-neutral-950 hover:text-[#bba15c] transition-colors">Accessories &amp; Footwear</a></h3>
          <p class="mt-2 text-sm font-light leading-relaxed text-neutral-500">Sneakers, bags, jewelry, and the finishing touches that complete a look. A change of shoes, a bag, or a piece of jewelry can shift an outfit from casual to polished without changing the clothes underneath.</p>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      {flagshipResolved && (
        <section class="py-10 md:py-20 border-b border-neutral-200/40">
          <div class="text-center mb-8 md:mb-14 space-y-2">
            <h2 class="text-[11px] font-sans tracking-[0.35em] uppercase text-neutral-950 font-bold">Editor's Picks</h2>
            <div class="w-12 h-[1px] bg-[#bba15c] mx-auto"></div>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-8 lg:gap-12">
            <a href={`/posts/${flagshipResolved.slug}/`} class="group block no-underline">
              <div class="w-full aspect-[4/5] sm:aspect-[16/11] overflow-hidden bg-neutral-100 relative">
                <img
                  src={flagshipResolved.dynamicImg}
                  alt={flagshipResolved.entry.title}
                  loading="lazy"
                  data-pin-nopin="true"
                  class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-103"
                  onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
                />
              </div>
              <div class="pt-5 space-y-2">
                {flagshipResolved.entry.categories?.[0] && (
                  <span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-[#bba15c]">
                    {categoryLabel(flagshipResolved.entry.categories[0])}
                  </span>
                )}
                <h3 class="text-2xl md:text-3xl font-serif font-light text-neutral-950 leading-tight group-hover:text-neutral-700 transition-colors">
                  {flagshipResolved.entry.title}
                </h3>
                <p class="text-neutral-500 text-sm font-light leading-relaxed max-w-lg">
                  {flagshipResolved.dynamicDesc}
                </p>
                <span class="inline-block pt-1 text-[11px] uppercase tracking-[0.2em] font-medium text-neutral-950 border-b border-neutral-950/20 group-hover:text-[#bba15c] group-hover:border-[#bba15c] transition-colors">
                  Read Story →
                </span>
              </div>
            </a>
            <div class="space-y-6 lg:space-y-7">
              {editorSupporting.map((post) => (
                <a href={`/posts/${post.slug}/`} class="group flex gap-4 items-start no-underline border-b border-neutral-200/40 pb-6 last:border-0 last:pb-0">
                  <div class="w-24 h-24 md:w-28 md:h-28 shrink-0 overflow-hidden bg-neutral-100 relative">
                    <img
                      src={post.dynamicImg}
                      alt={post.entry.title}
                      loading="lazy"
                      data-pin-nopin="true"
                      class="w-full h-full object-cover object-center"
                      onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
                    />
                  </div>
                  <div class="min-w-0 space-y-1">
                    {post.entry.categories?.[0] && (
                      <span class="block text-[9px] font-bold uppercase tracking-[0.2em] text-[#bba15c]">
                        {categoryLabel(post.entry.categories[0])}
                      </span>
                    )}
                    <h4 class="text-sm md:text-base font-serif font-light text-neutral-950 leading-snug line-clamp-2 group-hover:text-neutral-700 transition-colors">
                      {post.entry.title}
                    </h4>
                    <time datetime={post.entry.publishedDate} class="block text-[10px] uppercase tracking-[0.15em] text-neutral-400 pt-0.5">
                      {formatDate(post.entry.publishedDate)}
                    </time>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      {isMonetized && (
        <div class="my-12 p-6 bg-white border border-neutral-200/30 text-center relative max-w-5xl mx-auto">
          <span class="absolute -top-2.5 left-4 bg-[#F8F6F2] px-2 text-[9px] font-bold uppercase tracking-widest text-neutral-400">Sponsored</span>
          <AdSlot slot="header" format="horizontal" />
        </div>
      )}

      {latestPosts.length > 0 && (
        <section class="py-10 md:py-20 border-b border-neutral-200/40">
          <div class="text-center mb-8 md:mb-14 space-y-2">
            <h2 class="text-[11px] font-sans tracking-[0.35em] uppercase text-neutral-950 font-bold">Latest Posts</h2>
            <div class="w-12 h-[1px] bg-[#bba15c] mx-auto"></div>
          </div>
          <div class="hidden md:grid grid-cols-3 gap-8">
            {latestPosts.map((post) => (
              <PostCard
                title={post.entry.title}
                slug={post.slug}
                description={post.dynamicDesc}
                featuredImage={post.dynamicImg}
                publishedDate={post.entry.publishedDate}
                categories={post.entry.categories}
              />
            ))}
          </div>
          <div class="block md:hidden space-y-6">
            {latestPosts.map((post) => (
              <CompactPostRow
                title={post.entry.title}
                slug={post.slug}
                description={post.dynamicDesc}
                featuredImage={post.dynamicImg}
                categories={post.entry.categories}
              />
            ))}
          </div>
          <div class="text-center mt-10 md:mt-14">
            <a href="/posts/" class="inline-block text-[11px] uppercase tracking-[0.25em] font-medium text-neutral-950 border-b border-neutral-950/20 pb-1 hover:text-[#bba15c] hover:border-[#bba15c] transition-colors duration-300 no-underline">
              View All Articles →
            </a>
          </div>
        </section>
      )}

      <section class="py-10 md:py-20 border-b border-neutral-200/40">
        <div class="max-w-3xl mx-auto">
          <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.3em] text-[#bba15c]">How We Work</p>
          <h2 class="font-serif text-3xl font-light text-neutral-950 md:text-4xl">How the guides are put together</h2>
          <div class="mt-7 space-y-5 text-base font-light leading-relaxed text-neutral-600 md:text-lg">
            <p>Each guide starts with a reusable principle, then shows the outfit that follows from it. A principle you can explain — let one piece carry the volume, keep one clean line, or let the outer layer set the register — transfers to everything you own, while an outfit you merely copy stops working the moment one piece is in the wash. The guides therefore name the principle first, then the pieces, proportions, and layering order, so you can rebuild the look with what is already in your closet.</p>
            <p>Proportion and texture do most of the work. In fall, that means balancing volume — an oversized blazer over straight-leg jeans, or a chunky knit with slim trousers — and mixing textures within one color family, such as cable knit, wool, and cotton, so a single-color outfit does not look flat. Layering must stay visible to count: the collar above a knit vest, the cuffs past its armholes, the shirttail below its hem. If you cannot see three distinct edges, adjust the layers until you can.</p>
            <p>Most guides are written for clothes you already own. The fall guide built around that idea offers fifteen practical ways to style trendy fall looks using the clothing you already own, with no new purchases required, keeping budget and sustainability goals in mind. Try the combination first — an oversized blazer over a hoodie, a leather jacket over a midi dress, a turtleneck under a slip dress, or a statement coat over basic denim — and only then decide whether anything is actually missing. Start with <a href="/posts/11-minimalist-fall-outfit-formulas-from-your-closet/" class="text-neutral-950 underline underline-offset-4 hover:text-[#bba15c]">11 Minimalist Fall Outfit Formulas from Your Closet</a> for the principles, and <a href="/posts/12-fall-outfits-every-woman-needs/" class="text-neutral-950 underline underline-offset-4 hover:text-[#bba15c]">15 Fall Outfit Ideas Using Clothes You Already Own</a> for the combinations.</p>
          </div>
        </div>
      </section>

      {[
        { key: 'mens', title: "Men's Style", href: '/category/mens-fashion/', cta: "View Men's Style →", posts: mensPosts },
        { key: 'womens', title: "Women's Style", href: '/category/womens-fashion/', cta: "View Women's Style →", posts: womensPosts },
        { key: 'trends-and-aesthetics', title: 'Trends & Aesthetics', href: '/category/trends-and-aesthetics/', cta: 'Explore Trends →', posts: trendPosts },
      ].map(({ key, title, href, cta, posts }) => posts.length > 0 && (
