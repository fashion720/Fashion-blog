<script>
  const hero = document.querySelector<HTMLElement>('[data-hero-parallax]');
  const heroImage = document.querySelector<HTMLElement>('[data-hero-image]');
  const heroCopy = document.querySelector<HTMLElement>('[data-hero-copy]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(pointer: fine)');
  if (hero && heroImage && heroCopy && finePointer.matches && !reducedMotion.matches) {
    let frame = 0;
    let pointerX = 0;
    let pointerY = 0;
    hero.addEventListener('pointermove', (event) => {
      const rect = hero.getBoundingClientRect();
      pointerX = (event.clientX - rect.left) / rect.width - 0.5;
      pointerY = (event.clientY - rect.top) / rect.height - 0.5;
      if (!frame) {
        frame = requestAnimationFrame(() => {
          heroImage.style.transform = `translate3d(${(pointerX * 10).toFixed(2)}px, ${(pointerY * 8).toFixed(2)}px, 0)`;
          heroCopy.style.transform = `translate3d(${(-pointerX * 4).toFixed(2)}px, ${(-pointerY * 3).toFixed(2)}px, 0)`;
          frame = 0;
        });
      }
    });
    hero.addEventListener('pointerleave', () => {
      heroImage.style.transform = '';
      heroCopy.style.transform = '';
    });
  }
</script>

