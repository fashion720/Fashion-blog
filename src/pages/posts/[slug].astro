---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import SocialShare from '../../components/SocialShare.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import PopularPosts from '../../components/PopularPosts.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PostCard from '../../components/PostCard.astro';
import { marked } from 'marked';
import {
  getAllPosts,
  getAuthorBySlug,
  getPostsByCategory,
  getPostsByTag,
  getCategoryBreadcrumb,
  getAllCategories,
  getFeaturedPosts,
} from '../../lib/keystatic-reader';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { entry } = post;

const rawContent = (await entry.content()) as string;

// ─── TABLE OF CONTENTS ────────────────────────────────────────────────────
const tocItems: { id: string; text: string }[] = [];
const slugCounts: Record<string, number> = {};

function slugify(str: string) {
  return str
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '')
    .replace(/\s+/g, '-');
}

function uniqueSlug(str: string) {
  const base = slugify(str);
  const count = slugCounts[base] ?? 0;
  slugCounts[base] = count + 1;
  return count === 0 ? base : `${base}-${count}`;
}

let renderedContent = marked(rawContent ?? '') as string;

// Add IDs to every H2 heading and collect them for the TOC
renderedContent = renderedContent.replace(/<h2>(.*?)<\/h2>/gs, (_match, inner) => {
  const text = inner.replace(/<[^>]+>/g, '').trim();
  const id = uniqueSlug(text);
  tocItems.push({ id, text });
  return `<h2 id="${id}">${inner}</h2>`;
});

// ─── CONTEXTUAL AUTO-LINKING ───────────────────────────────────────────────
// Scans the article body for plain-text mentions of *other* category names
// and links the first mention of each to that category page — free internal
// links without the author having to add them by hand.
function escapeRegExp(str: string) {
  return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function autoLinkCategories(html: string, categories: { slug: string; name: string }[]) {
  const parts = html.split(/(<[^>]+>)/g); // alternating text / tag chunks
  let insideAnchor = false;
  let linksAdded = 0;
  const MAX_LINKS = 4;

  for (const cat of categories) {
    if (linksAdded >= MAX_LINKS) break;
    if (!cat.name || cat.name.trim().length < 4) continue; // skip short/ambiguous names
    const regex = new RegExp(`\\b(${escapeRegExp(cat.name)})\\b`, 'i');
    let linked = false;

    for (let i = 0; i < parts.length && !linked; i++) {
      const part = parts[i];
      if (part.startsWith('<')) {
        if (/^<a[\s>]/i.test(part)) insideAnchor = true;
        if (/^<\/a>/i.test(part)) insideAnchor = false;
        continue;
      }
      if (insideAnchor) continue;
      if (regex.test(part)) {
        parts[i] = part.replace(
          regex,
          (m) => `<a href="/category/${cat.slug}/" class="text-[#bba15c] underline underline-offset-4 font-normal">${m}</a>`
        );
        linked = true;
        linksAdded++;
      }
    }
  }

  return parts.join('');
}

const allCategoriesForLinking = await getAllCategories();
const categoriesToLink = allCategoriesForLinking
  .filter((c) => !entry.categories?.includes(c.slug))
  .map((c) => ({ slug: c.slug, name: c.entry.name }));

renderedContent = autoLinkCategories(renderedContent, categoriesToLink);

// Only show TOC on longer list-style articles
const showToc = tocItems.length >= 5;

// Drop the final closing/wrap-up heading from the TOC (not useful to jump to)
const tocDisplayItems = showToc ? tocItems.slice(0, -1) : [];

// Tag each numbered idea/outfit section heading with its ordinal position
// (same numbering already shown in the TOC above) so the article body can
// give it an elegant number treatment — purely a data attribute, the
// heading text itself is untouched.
if (showToc) {
  const numberedItems = tocDisplayItems.filter((item) => !/faq|frequently asked/i.test(item.text));
  const idxById = new Map(numberedItems.map((item, i) => [item.id, i + 1]));
  renderedContent = renderedContent.replace(
    /<h2 id="([^"]+)">/g,
    (match, id) => (idxById.has(id) ? `<h2 id="${id}" data-idx="${idxById.get(id)}">` : match)
  );
}

// Build TOC HTML and inject it right before the first H2 (i.e. after the intro paragraph)
if (showToc) {
  // Strip a leading "Look 1:", "Outfit 2:", "Step 3:" style prefix so the
  // TOC doesn't show double numbering ("1. Look 1: ...") — the <ol> already
  // supplies the number, so only the descriptive part of the title is kept.
  function stripLeadingNumberLabel(text: string) {
    // Look for a short leading label (up to ~30 chars) ending in a colon/dash,
    // e.g. "Look 1:", "Outfit 2:", "T Shirt 1:", "Item Name:", "Style #3 -".
    // Strip it when it either contains a digit (redundant with the <ol>
    // number) OR is one of a handful of known filler labels that carry no
    // real information ("Item Name:" repeated identically on every heading).
    const labelMatch = text.match(/^(.{1,30}?)[:.\-–—]\s*/);
    if (!labelMatch) return text;
    const label = labelMatch[1].trim();
    const isGenericFiller = /^(item\s*name|item|look|outfit|idea|style|piece|design)$/i.test(label);
    if (/\d/.test(label) || isGenericFiller) {
      return text.slice(labelMatch[0].length).trim();
    }
    return text;
  }

  const tocListItems = tocDisplayItems
    .map(
      (item) =>
        `<li><a href="#${item.id}" class="text-sm text-neutral-700 hover:text-[#bba15c] transition no-underline leading-snug">${stripLeadingNumberLabel(item.text)}</a></li>`
    )
    .join('');

  const tocHtml = `<nav class="not-prose my-10 p-6 bg-white border border-neutral-200/30 shadow-sm/5 rounded-sm block w-full" aria-label="Table of Contents"><p class="text-[11px] font-sans tracking-[0.35em] uppercase text-neutral-950 font-bold mb-4">Table of Contents</p><ol class="space-y-2.5 list-decimal list-inside marker:text-neutral-950 marker:font-bold pl-0">${tocListItems}</ol></nav>`;

  renderedContent = renderedContent.replace('<h2', `${tocHtml}<h2`);
}

const author = entry.author ? await getAuthorBySlug(entry.author) : null;

// 👑 SCRAPER: Direct local file text analysis loop matches Canvas architecture
function getPostImage(rawContent: string) {
  if (!rawContent) return null;
  // ⚡ FIX: require the captured URL to end in an image extension. Without
  // this, a nested markdown link inside the alt text (e.g. an inline
  // "[sneakers](/posts/...)" reference) tricks the old regex into grabbing
  // that link's URL instead of the actual image path, producing broken
  // images on cards/category pages.
  const match = rawContent.match(/!\[[\s\S]*?\]\(([^)]+\.(?:jpe?g|png|gif|webp|svg))\)/i);
  if (match && match[1]) {
    return match[1].trim();
  }
  return null;
}

const featuredImage = getPostImage(rawContent);
const postUrl = new URL(`/posts/${post.slug}/`, Astro.site).toString();

const formattedDate = entry.publishedDate
  ? new Date(entry.publishedDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';

// Only show an "Updated" date when one exists AND it actually differs from
// the published date — otherwise it's just noise repeating the same date.
const formattedUpdatedDate =
  entry.updatedDate && entry.updatedDate !== entry.publishedDate
    ? new Date(entry.updatedDate).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    : '';

// 👑 UPGRADED METADATA PARSER: Direct content analysis loop (no duplicate variables)
function getPostDescription(rawContent: string, length = 160) {
  if (!rawContent) return "Explore contemporary style and curated fashion insights inside this editorial.";
  const cleanText = rawContent
    .replace(/[#*_`~]/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/^[-\s]*\n/gm, '')
    .trim();
  return cleanText.length > length ? `${cleanText.substring(0, length)}...` : cleanText;
}

const seoDescription = getPostDescription(rawContent, 160);
const isMonetized = false;

// ─── BREADCRUMBS ─────────────────────────────────────────────────────────────
const primaryCategorySlug = entry.categories?.[0];
const categoryBreadcrumb = primaryCategorySlug
  ? await getCategoryBreadcrumb(primaryCategorySlug)
  : null;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  ...(categoryBreadcrumb?.parent
    ? [{ label: categoryBreadcrumb.parent.name, href: `/category/${categoryBreadcrumb.parent.slug}/` }]
    : []),
  ...(categoryBreadcrumb?.current
    ? [{ label: categoryBreadcrumb.current.name, href: `/category/${categoryBreadcrumb.current.slug}/` }]
    : []),
  { label: entry.title },
];

// ─── RELATED POSTS ────────────────────────────────────────────────────────────

// Fisher-Yates shuffle so related posts rotate per build instead of always
// showing the same fixed 3 articles for every post in a category.
function shuffleArray<T>(arr: T[]): T[] {
  const result = [...arr];
  for (let i = result.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [result[i], result[j]] = [result[j], result[i]];
  }
  return result;
}

const categoryPoolForRelated = primaryCategorySlug
  ? (await getPostsByCategory(primaryCategorySlug)).filter((p) => p.slug !== post.slug)
  : [];

// ⚡ Cross-category matches: posts that share a tag with this post, even if
// they live in a different category. Widens the related-posts pool beyond
// a single category so internal links reach across the site.
const tagPoolForRelated = entry.tags && entry.tags.length > 0
  ? (await getPostsByTag(entry.tags)).filter((p) => p.slug !== post.slug)
  : [];

const combinedPoolForRelated = [...categoryPoolForRelated, ...tagPoolForRelated].filter(
  (p, index, arr) => arr.findIndex((x) => x.slug === p.slug) === index
);

const relatedPostsRaw = shuffleArray(combinedPoolForRelated).slice(0, 3);

const categoryNameForRelated = categoryBreadcrumb?.current?.name ?? null;

const relatedPosts = await Promise.all(
  relatedPostsRaw.map(async (related) => {
    const relatedRaw = (await related.entry.content()) as string;
    return {
      slug: related.slug,
      title: related.entry.title,
      description: getPostDescription(relatedRaw, 90),
      featuredImage: getPostImage(relatedRaw),
      publishedDate: related.entry.publishedDate,
      categories: related.entry.categories,
    };
  })
);

// Used only to decide whether the "Trending Now" heading should render —
// PopularPosts fetches and displays this same data itself.
const trendingPosts = await getFeaturedPosts(5);
---

<Layout
  title={`${entry.title} — Fashion Editorial`}
  description={seoDescription}
  image={featuredImage || '/images/og/default.jpg'}
  article={true}
  publishedTime={entry.publishedDate}
  modifiedTime={entry.updatedDate}
  author={author?.name}
  tags={entry.tags}
>
  <ReadingProgress />
  <Header currentPath={`/posts/${post.slug}`} />

  <main class="min-h-screen bg-[#F8F6F2] text-neutral-900 font-sans antialiased max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16 overflow-x-hidden w-full block">

    <Breadcrumbs items={breadcrumbItems} />

    <div class="lg:flex lg:items-start lg:gap-12">

    <article class="w-full block lg:flex-1 lg:min-w-0">
      
      {/* 📋 NARROW STRUCTURE WRAPPER: Title Header block */}
      <header class="text-center mb-8 md:mb-10 space-y-4 max-w-[720px] mx-auto block">
        {entry.categories && entry.categories.length > 0 && (
          <div class="flex justify-center gap-x-4 gap-y-1 items-center flex-wrap">
            {entry.categories.map((cat: string) => (
              <a href={`/category/${cat}/`} class="text-[10px] font-bold uppercase tracking-[0.25em] text-[#bba15c] hover:opacity-80 transition no-underline">
                {cat.replace(/-/g, ' ')}
              </a>
            ))}
          </div>
        )}
        
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5.5xl font-serif font-light tracking-tight text-neutral-950 leading-[1.15] max-w-2xl mx-auto break-words">
          {entry.title}
        </h1>

        <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[10px] uppercase tracking-[0.2em] text-neutral-400 font-sans pt-2">
          {author && <span class="font-bold text-neutral-800 tracking-widest">{author.name}</span>}
          {author && <span class="text-neutral-300">•</span>}
          <time datetime={entry.publishedDate}>{formattedDate}</time>
          {formattedUpdatedDate && (
            <>
              <span class="text-neutral-300">•</span>
              <span class="text-neutral-400 normal-case tracking-normal">Updated {formattedUpdatedDate}</span>
            </>
          )}
        </div>
        
        <div class="w-16 h-[1px] bg-[#bba15c] mx-auto pt-4"></div>
      </header>

      {/* 🖼️ FEATURED IMAGE: large editorial hero, framed to match in-article image treatment */}
      {featuredImage && (
        <div class="max-w-4xl mx-auto mb-10 md:mb-14 block w-full overflow-hidden border border-neutral-200/20 shadow-sm rounded-sm bg-white">
          <img
            src={featuredImage}
            alt={entry.title}
            width="1200"
            height="800"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="w-full h-auto object-cover block"
          />
        </div>
      )}

      {/* 📖 ARTICLE BODY: Standard narrow reading width (editorial column, ~720px) */}
      <div class="max-w-[720px] mx-auto block overflow-hidden w-full">
        <div class="prose prose-neutral max-w-none fashion-prose-content block w-full break-words" set:html={renderedContent} />

        {/* 💸 IN-CONTENT SPONSORED PANEL BUFFER MAP */}
        {isMonetized && (
          <div class="my-12 p-6 bg-white border border-neutral-200/30 shadow-sm/5 rounded-sm text-center relative w-full block">
            <span class="absolute -top-2.5 left-4 bg-[#F8F6F2] px-2 text-[9px] font-bold uppercase tracking-widest text-neutral-400">Sponsored Content</span>
            <AdSlot slot="in-content" format="horizontal" />
          </div>
        )}

        {/* ✉️ SHARING ACTION REGISTRY DRAWER */}
        <div class="border-t border-b border-neutral-200/40 py-5 my-10 flex items-center justify-between gap-4 w-full flex-wrap sm:flex-nowrap">
          <span class="text-[10px] uppercase tracking-[0.2em] text-neutral-400 font-bold whitespace-nowrap">Share This Article</span>
          <SocialShare
            title={entry.title}
            description={seoDescription}
            url={postUrl}
            image={featuredImage ? new URL(featuredImage, Astro.site).toString() : ''}
          />
        </div>

        {/* Author info now lives in one place — the sidebar "Meet the
            Author" card — so it isn't duplicated at the end of the
            article. See the <aside> after </article> below. */}
      </div>

    </article>

    {/* 👤 AUTHOR SIDEBAR CARD: sticky on desktop, stacks below article on mobile */}
    {author && (
      <aside class="mt-10 lg:mt-0 lg:w-[300px] lg:shrink-0">
        <div class="lg:sticky lg:top-28 bg-white border border-neutral-200/30 shadow-sm/5 rounded-sm overflow-hidden max-w-[420px] mx-auto lg:max-w-none lg:mx-0">
          {author.avatar && (
            <img
              src={`/images/authors/${author.avatar}`}
              alt={author.name}
              width="400"
              height="400"
              loading="lazy"
              decoding="async"
              class="w-full aspect-square object-cover block select-none pointer-events-none"
            />
          )}
          <div class="p-6 text-center space-y-3">
            <p class="text-[10px] font-sans font-bold uppercase tracking-[0.25em] text-[#bba15c]">Meet the Author</p>
            <p class="font-serif text-xl font-light text-neutral-950">{author.name}</p>
            {author.bio && (
              <p class="text-xs text-neutral-500 font-light leading-relaxed break-words">{author.bio}</p>
            )}
            {author.social && (author.social.pinterest || author.social.instagram || author.social.twitter) && (
              <div class="flex items-center justify-center gap-4 pt-2">
                {author.social.pinterest && (
                  <a href={author.social.pinterest} target="_blank" rel="noopener noreferrer" aria-label={`${author.name} on Pinterest`} class="text-neutral-400 hover:text-[#bba15c] transition">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.992 3.993-.283 1.194.599 2.169 1.775 2.169 2.13 0 3.769-2.247 3.769-5.491 0-2.871-2.063-4.878-5.01-4.878-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.179 23.774 10.551 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
                  </a>
                )}
                {author.social.instagram && (
                  <a href={author.social.instagram} target="_blank" rel="noopener noreferrer" aria-label={`${author.name} on Instagram`} class="text-neutral-400 hover:text-[#bba15c] transition">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  </a>
                )}
                {author.social.twitter && (
                  <a href={author.social.twitter} target="_blank" rel="noopener noreferrer" aria-label={`${author.name} on X`} class="text-neutral-400 hover:text-[#bba15c] transition">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </aside>
    )}

    </div>

    {/* 🔗 RELATED POSTS: same-category articles to strengthen internal linking */}
    {relatedPosts.length > 0 && (
      <section class="mt-16 pt-12 border-t border-neutral-200/40 max-w-7xl mx-auto w-full block">
        <div class="text-center mb-10 md:mb-14 space-y-2">
          <h3 class="text-[11px] font-sans tracking-[0.35em] uppercase text-neutral-950 font-bold">You Might Also Like</h3>
          <div class="w-12 h-[1px] bg-[#bba15c] mx-auto"></div>
          {categoryNameForRelated && primaryCategorySlug && (
            <p class="pt-1">
              <a href={`/category/${primaryCategorySlug}/`} class="text-[11px] uppercase tracking-[0.15em] text-neutral-500 hover:text-[#bba15c] transition no-underline">
                Explore more in {categoryNameForRelated} →
              </a>
            </p>
          )}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
          {relatedPosts.map((related) => (
            <PostCard
              title={related.title}
              slug={related.slug}
              description={related.description}
              featuredImage={related.featuredImage}
              publishedDate={related.publishedDate}
              categories={related.categories}
            />
          ))}
        </div>
      </section>
    )}

    {trendingPosts.length > 0 && (
      <section class="mt-16 pt-12 border-t border-neutral-200/40 max-w-2xl mx-auto w-full block">
        <div class="text-center mb-10 md:mb-14 space-y-2">
          <h3 class="text-[11px] font-sans tracking-[0.35em] uppercase text-neutral-950 font-bold">Trending Now</h3>
          <div class="w-12 h-[1px] bg-[#bba15c] mx-auto"></div>
        </div>
        <PopularPosts />
      </section>
    )}

  </main>

  <Footer />
</Layout>

<script define:vars={{ postUrl, postTitle: entry.title }}>
  document.addEventListener('DOMContentLoaded', () => {
    const contentDiv = document.querySelector('.fashion-prose-content');
    if (!contentDiv) return;

    const images = contentDiv.querySelectorAll('img');

    images.forEach((img) => {
      // Create wide wrapper container Frame Frame (matching provided Canvas style Architecture)
      // ⚡ PADDING KILLED LAYER: Set padding to p-0 and overflow-hidden to clean up layout borders completely
      const wrapper = document.createElement('div');
      wrapper.className = 'img-pin-wrapper my-12 block w-full bg-white p-0 overflow-hidden border border-neutral-200/20 shadow-sm rounded-sm';

      // Insert wrapper before image, move image inside wrapper
      img.parentNode.insertBefore(wrapper, img);
      wrapper.appendChild(img);

      // Apply styling to image element to fill Frame properly properly
      img.style.margin = '0';
      img.style.width = '100%';
      img.style.display = 'block';
      img.classList.add('rounded-[1px]');

      // Construct final final absolute Pinterest save save parameters
      const imgSrc = img.getAttribute('src');
      const absoluteImgSrc = imgSrc?.startsWith('http')
        ? imgSrc
        : window.location.origin + imgSrc;

      const pinBtn = document.createElement('a');
      pinBtn.href = `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(postUrl)}&media=${encodeURIComponent(absoluteImgSrc)}&description=${encodeURIComponent(img.alt || postTitle)}`;
      pinBtn.target = '_blank';
      pinBtn.rel = 'noopener noreferrer';
      pinBtn.className = 'pin-save-btn';
      
      // 👑 STYLING FIX: Injected direct full width inline configurations so button stretches cleanly under tight p-0 layout frames
      pinBtn.style.cssText = 'display:flex!important; align-items:center!important; justify-content:center!important; gap:8px!important; width:100%!important; padding:11px 0!important; background:#fff!important; border-top:1px solid rgba(229,231,235,0.5)!important; color:#E60023!important; font-size:10.5px!important; font-weight:700!important; letter-spacing:0.2em!important; text-transform:uppercase!important; text-decoration:none!important; cursor:pointer!important; font-family:sans-serif!important; border-radius:0!important; border-left:0!important; border-right:0!important; border-bottom:0!important;';
      
      pinBtn.innerHTML = `
        <svg width="13" height="14" viewBox="0 0 24 24" fill="#E60023" style="transition:fill 0.3s ease;"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.992 3.993-.283 1.194.599 2.169 1.775 2.169 2.13 0 3.769-2.247 3.769-5.491 0-2.871-2.063-4.878-5.01-4.878-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.179 23.774 10.551 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
        Save to Pinterest
      `;

      // Hover bindings to maintain luxury contrast feel dynamically dynamically
      pinBtn.addEventListener('mouseenter', () => {
        pinBtn.style.background = '#E60023';
        pinBtn.style.color = '#fff';
        pinBtn.querySelector('svg').style.fill = '#fff';
      });
      pinBtn.addEventListener('mouseleave', () => {
        pinBtn.style.background = '#fff';
        pinBtn.style.color = '#E60023';
        pinBtn.querySelector('svg').style.fill = '#E60023';
      });

      wrapper.appendChild(pinBtn);
    });

    // ── FAQ → accordion ────────────────────────────────────────────────
    // Finds an existing "FAQ" heading and progressively enhances the
    // Q/A paragraphs beneath it into native <details>/<summary> accordion
    // items. Content and copy are untouched — this only restructures how
    // the same Q1:/A1: text already in the article is presented.
    const headings = contentDiv.querySelectorAll('h2');
    let faqHeading = null;
    headings.forEach((h) => {
      if (!faqHeading && /faq|frequently asked/i.test(h.textContent || '')) faqHeading = h;
    });

    if (faqHeading) {
      let node = faqHeading.nextElementSibling;
      while (node && node.tagName !== 'H2') {
        const next = node.nextElementSibling;

        if (node.tagName === 'P' && /<br\s*\/?>/i.test(node.innerHTML)) {
          const [rawQ, rawA] = node.innerHTML.split(/<br\s*\/?>/i);
          if (rawQ && rawA) {
            const question = rawQ.replace(/^\s*Q\d*[:.]?\s*/i, '').trim();
            const answer = rawA.replace(/^\s*A\d*[:.]?\s*/i, '').trim();

            const details = document.createElement('details');
            details.className = 'faq-item not-prose';

            const summary = document.createElement('summary');
            summary.className = 'faq-question';
            summary.innerHTML = `<span>${question}</span><svg class="faq-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><line x1="10" y1="4" x2="10" y2="16"/><line x1="4" y1="10" x2="16" y2="10"/></svg>`;

            const answerDiv = document.createElement('div');
            answerDiv.className = 'faq-answer';
            answerDiv.innerHTML = answer;

            details.appendChild(summary);
            details.appendChild(answerDiv);
            node.replaceWith(details);
          }
        }

        node = next;
      }
    }
  });
</script>

