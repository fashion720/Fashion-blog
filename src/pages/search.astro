---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getAllPosts } from '../lib/keystatic-reader';

const allPosts = await getAllPosts();
const searchIndex = await Promise.all(allPosts.map(async (post) => {
  const rawContent = ((await post.entry.content()) as string) || '';
  const imageMatch = rawContent.match(/!\[.*?\]\((.*?)\)/);
  const description = (post.entry.description || rawContent.replace(/[#*_`~]/g, '').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').trim().slice(0, 160));
  return {
    title: post.entry.title || 'Untitled Article',
    description,
    content: rawContent.replace(/[#*_`~\[\]()]/g, ' '),
    slug: post.slug,
    image: imageMatch?.[1]?.trim() || '/images/placeholder.jpg',
    publishedDate: post.entry.publishedDate || new Date().toISOString(),
    categories: post.entry.categories || [],
    tags: post.entry.tags || [],
  };
}));
---

<Layout title="Search | Outfit Edits" description="Search outfit ideas, style guides, trends, and fashion inspiration on Outfit Edits.">
  <Header currentPath="/search" />
  <main class="min-h-screen overflow-x-hidden bg-[#F8F6F2] px-4 pb-20 text-neutral-900 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <header class="border-b border-neutral-200/70 py-12 text-center md:py-16"><p class="mb-3 text-[10px] font-bold uppercase tracking-[0.3em] text-[#bba15c]">Outfit Edits / Discovery</p><h1 class="font-serif text-4xl font-light tracking-tight text-neutral-950 md:text-6xl">Search</h1><form action="/search" method="GET" class="mx-auto mt-8 flex max-w-2xl border-b border-neutral-950 bg-transparent"><label for="search-page-input" class="sr-only">Search articles</label><input id="search-page-input" name="q" type="search" placeholder="Search outfit ideas, trends, and style guides..." class="min-w-0 flex-1 bg-transparent px-1 py-3 text-sm font-light outline-none placeholder:text-neutral-400" /><button type="submit" class="px-3 py-3 text-[10px] uppercase tracking-[0.18em] text-neutral-950">Search →</button></form></header>
      <section class="pt-10"><p id="search-result-label" class="mb-8 text-center font-serif text-2xl font-light text-neutral-950">Search results</p><div id="search-results-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"></div></section>
    </div>
  </main>
  <Footer />
</Layout>

<script define:vars={{ searchIndex }}>
  const suggestions = ['Outfit Ideas', "Men's Style", "Women's Style", 'Fashion Trends', 'Denim', 'Shoes'];
  const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' })[char]);
  const search = () => {
    const params = new URLSearchParams(window.location.search);
    const query = (params.get('q') || '').trim();
    const label = document.querySelector('#search-result-label');
    const grid = document.querySelector('#search-results-grid');
    if (!label || !grid) return;
    if (!query) {
      label.textContent = 'Search outfit ideas, trends, and style guides';
      grid.innerHTML = '<div class="col-span-full border-y border-neutral-200/70 py-20 text-center text-sm font-light text-neutral-500">Use the search field above to explore the archive.</div>';
      return;
    }
    label.textContent = `Results for: ${query}`;
    const q = query.toLowerCase();
    const scored = searchIndex.map((post) => {
      const title = post.title.toLowerCase();
      const categories = post.categories.join(' ').replace(/-/g, ' ').toLowerCase();
      const tags = post.tags.join(' ').replace(/-/g, ' ').toLowerCase();
      const content = `${post.description} ${post.content}`.toLowerCase();
      let score = 0;
      if (title === q) score += 100;
      else if (title.includes(q)) score += 60;
      if (categories.includes(q)) score += 35;
      if (tags.includes(q)) score += 25;
      if (content.includes(q)) score += 10;
      return { post, score };
    }).filter((item) => item.score > 0).sort((a, b) => b.score - a.score).map((item) => item.post);
    if (!scored.length) {
      grid.innerHTML = `<div class="col-span-full py-16 text-center"><p class="font-serif text-2xl font-light text-neutral-950">No stories found for '${escapeHtml(query)}'.</p><p class="mt-6 text-[10px] uppercase tracking-[0.2em] text-neutral-400">Try searching for:</p><div class="mt-5 flex flex-wrap justify-center gap-2">${suggestions.map((item) => `<a href="/search?q=${encodeURIComponent(item)}" class="border border-neutral-200 bg-white px-4 py-3 text-[10px] uppercase tracking-[0.12em] text-neutral-600 hover:border-neutral-950 hover:text-neutral-950">${item}</a>`).join('')}</div></div>`;
      return;
    }
    grid.innerHTML = scored.map((post) => {
      const category = post.categories[0] ? post.categories[0].replace(/-/g, ' ') : '';
      const date = new Date(post.publishedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
      return `<article class="group flex min-w-0 flex-col overflow-hidden border border-neutral-200/60 bg-white p-4 transition-shadow hover:shadow-sm"><a href="/posts/${encodeURIComponent(post.slug)}/" class="relative block aspect-[4/5] overflow-hidden bg-neutral-100"><img src="${escapeHtml(post.image)}" alt="${escapeHtml(post.title)}" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.onerror=null;this.src='/images/placeholder.jpg';"></a><div class="flex flex-1 flex-col pt-5">${category ? `<span class="mb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[#bba15c]">${escapeHtml(category)}</span>` : ''}<h2 class="line-clamp-2 min-h-[3.2rem] font-serif text-xl font-light leading-tight text-neutral-950">${escapeHtml(post.title)}</h2><p class="mt-3 line-clamp-2 text-xs font-light leading-relaxed text-neutral-500">${escapeHtml(post.description)}</p><div class="mt-auto flex items-center justify-between border-t border-neutral-100 pt-4"><time class="text-[10px] uppercase tracking-[0.12em] text-neutral-400">${date}</time><a href="/posts/${encodeURIComponent(post.slug)}/" class="text-[10px] uppercase tracking-[0.12em] text-neutral-700 hover:text-[#bba15c]">Read Story →</a></div></div></article>`;
    }).join('');
  };
  search();
  document.addEventListener('astro:page-load', search);
</script>

<style is:global>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
