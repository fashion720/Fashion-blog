---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Editorial Guidelines Policy | Outfit Edits';
const pageDescription = 'How Outfit Edits researches, writes, and reviews its fashion and styling content.';
const lastUpdated = 'July 1, 2026';

const sections = [
  { title: 'Our Editorial Mission', body: 'Outfit Edits publishes outfit ideas, style guides, and fashion content that readers can trust and actually use. Our focus is practical styling, seasonal fashion, and clear guidance for everyday wardrobes.' },
  { title: 'Content Selection', body: 'Every article is built around a practical styling question: how to wear a specific piece, put together an outfit for an occasion, or approach a seasonal trend. We prioritize content that gives readers a useful starting point.' },
  { title: 'Research & Fact Checking', body: 'Our writers research current fashion trends, wardrobe staples, and styling techniques before drafting a guide. Articles are reviewed for accuracy, clarity, and usefulness before publishing.' },
  { title: 'Writing & Editing', body: 'We aim to describe outfits, garments, and styling techniques as precisely as possible so readers can understand and recreate the looks we cover. Content is written to be clear, practical, and easy to follow.' },
  { title: 'Updates & Corrections', body: 'Fashion trends and seasonal recommendations change. When an article becomes outdated, we update it to reflect current styling advice rather than leaving stale information live. If you notice an error, please report it through our Contact Us page.' },
  { title: 'Images & Visual Content', body: 'Visuals used across our articles are created or sourced to represent the styling ideas described in the text as closely as possible. We do not knowingly use images in a way that misrepresents a product or outfit.' },
  { title: 'Affiliate / Sponsored Content', body: "Outfit Edits' editorial recommendations are based on our own styling judgment and research. Any sponsored content, affiliate links, or partnerships will be clearly disclosed within the relevant article." },
  { title: 'AI & Content Policy', body: 'Our published fashion guidance is reviewed for clarity, accuracy, and usefulness before it appears on the site. We do not make claims about a separate automated editorial process beyond this existing review standard.' },
  { title: 'Contact / Corrections', body: 'For an article question or correction request, please visit our Contact Us page. Providing the article URL and describing the issue helps the editorial team understand the request.' },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Header currentPath="/editorial-guidelines-policy" />
  <main class="min-h-screen overflow-x-hidden bg-[#F8F6F2] px-4 pb-20 text-neutral-900 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <header class="border-b border-neutral-200/70 py-12 md:py-20"><p class="mb-4 text-[10px] font-bold uppercase tracking-[0.3em] text-[#bba15c]">Outfit Edits / Standards</p><h1 class="font-serif text-4xl font-light leading-tight text-neutral-950 md:text-6xl">Editorial Guidelines Policy</h1><p class="mt-6 max-w-2xl text-base font-light leading-relaxed text-neutral-600">How we select, research, write, review, and maintain fashion and styling content.</p><p class="mt-5 text-xs uppercase tracking-[0.15em] text-neutral-400">Last updated: {lastUpdated}</p></header>
      <div class="divide-y divide-neutral-200/70">
        {sections.map((section) => <section class="grid gap-4 py-9 md:grid-cols-[0.8fr_1.2fr] md:gap-12 md:py-12"><h2 class="font-serif text-2xl font-light text-neutral-950 md:text-3xl">{section.title}</h2><p class="text-base font-light leading-relaxed text-neutral-600">{section.body}{section.title.includes('Corrections') && <>{' '}<a href="/contact/" class="border-b border-neutral-950/30 text-neutral-950 hover:text-[#bba15c]">Contact Us →</a></>}</p></section>)}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
