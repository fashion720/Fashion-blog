---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = 'Fashion Reels | Fashion 720';
const pageDescription = 'Watch our latest fashion Reels — outfit ideas, styling tips and seasonal looks from the Fashion 720 blog.';

// Add each new Reel at the top of this list.
const reels = [
  {
    title: 'Comfortable Legging Outfits That Look Polished, Not Lazy',
    href: '/posts/15-cute-ideas-for-comfortable-legging-outfits-casual-style/',
    image: '/images/content/15-cute-ideas-for-comfortable-legging-outfits-casual-style/inline-1.webp',
    blurb: 'Polished, not lazy — six legging outfits that look put together, from a cream sweater to a satin blouse.',
    date: '12 November 2026',
  },
  {
    title: '22 Chic Winter Outfit Ideas That Look Effortless, Not Overdone',
    href: '/posts/22-chic-winter-outfit-ideas-that-look-effortless-not-overdone/',
    image: '/images/content/22-chic-winter-outfit-ideas-that-look-effortless-not-overdone/inline-1.webp',
    blurb: 'Cozy knits, tailored coats and easy layers — 22 winter looks that feel polished without trying too hard.',
    date: '12 November 2026',
  },
  {
    title: '17 Chic Looks for the Best UGG Outfits with a Winter Aesthetic',
    href: '/posts/17-chic-looks-for-the-best-ugg-outfits-with-a-winter-aesthetic/',
    image: '/images/content/17-chic-looks-for-the-best-ugg-outfits-with-a-winter-aesthetic/inline-1.webp',
    blurb: 'UGG boots styled 17 ways — cozy, chic and unmistakably winter, from chunky knits to tailored coats.',
    date: '12 November 2026',
  },
  {
    title: 'How to Style Brown Leather Pants Without Looking Dated',
    href: '/posts/how-to-style-brown-leather-pants-without-looking-dated/',
    image: '/images/content/how-to-style-brown-leather-pants-without-looking-dated/inline-1.webp',
    blurb: 'Brown leather pants, styled six ways — the outfits, shoes and layers that keep them modern.',
    date: '12 November 2026',
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main class="reels-page">
    <section class="reels-hero">
      <p class="eyebrow">Fashion 720</p>
      <h1>Fashion Reels</h1>
      <p class="lede">Short, scrollable outfit ideas — tap a Reel to open the full look.</p>
    </section>

    <section class="reels-grid" aria-label="Fashion Reels">
      {
        reels.map((reel) => (
          <article class="reel-card">
            <a class="reel-media" href={reel.href} aria-label={reel.title}>
              <img src={reel.image} alt={reel.title} loading="lazy" />
            </a>
            <div class="reel-body">
              <p class="reel-date">{reel.date}</p>
              <h2>
                <a href={reel.href}>{reel.title}</a>
              </h2>
              <p class="reel-blurb">{reel.blurb}</p>
              <a class="reel-link" href={reel.href}>View the look →</a>
            </div>
          </article>
        ))
      }
    </section>
  </main>
  <Footer />
</Layout>
