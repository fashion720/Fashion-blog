---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Terms of Service | Outfit Edits";
const pageDescription = "Terms and conditions for using the Outfit Edits website, outfitedits.com.";
const lastUpdated = "July 1, 2026";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold mb-2">Terms of Service</h1>
    <p class="text-sm text-gray-600 mb-6">Last updated: {lastUpdated}</p>

    <div class="prose prose-lg max-w-none">
      <p>
        These Terms of Service ("Terms") govern your use of
        outfitedits.com (the "Site"), operated by Outfit Edits. By
        accessing or using the Site, you agree to be bound by these Terms.
      </p>

      <h2 class="text-2xl font-semibold mt-8 mb-3">Use of the Site</h2>
      <p>
        Outfit Edits provides fashion and styling content, including
        outfit ideas, seasonal guides, and DIY inspiration, for general
        informational purposes. You may browse and read the Site's content
        for personal, non-commercial use.
      </p>

      <h2 class="text-2xl font-semibold mt-8 mb-3">Content Ownership</h2>
      <p>
        All articles, images, graphics, and other content published on
        Outfit Edits, unless otherwise credited, are the property of
        Outfit Edits and may not be reproduced, republished, or
        redistributed without prior written permission.
      </p>

      <h2 class="text-2xl font-semibold mt-8 mb-3">Styling Advice Disclaimer</h2>
      <p>
        Outfit and styling suggestions on this Site reflect general
        fashion guidance and personal editorial opinion. Individual style,
        fit, and preference vary, and readers should adapt any
        recommendation to their own body, budget, and circumstances.
      </p>

      <h2 class="text-2xl font-semibold mt-8 mb-3">Third-Party Links</h2>
      <p>
        The Site may contain links to third-party websites, including
        retailers or affiliate partners. Outfit Edits is not responsible
        for the content, accuracy, or practices of any linked external
        site.
      </p>

      <h2 class="text-2xl font-semibold mt-8 mb-3">Limitation of Liability</h2>
      <p>
        Outfit Edits is not liable for any damages arising from your use
        of, or inability to use, the Site or its content, to the fullest
        extent permitted by law.
      </p>

      <h2 class="text-2xl font-semibold mt-8 mb-3">Changes to These Terms</h2>
      <p>
        We may update these Terms from time to time. Continued use of the
        Site after changes are posted constitutes acceptance of the
        revised Terms.
      </p>

      <h2 class="text-2xl font-semibold mt-8 mb-3">Contact</h2>
      <p>
        Questions about these Terms can be sent through our
        <a href="/contact" class="underline">Contact Us</a> page.
      </p>
    </div>
  </main>
</Layout>
