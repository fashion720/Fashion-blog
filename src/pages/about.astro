---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPostsByCategory, getAuthorBySlug } from '../lib/keystatic-reader';

const pageTitle = 'About Outfit Edits | Fashion & Style Inspiration';
const pageDescription = 'Outfit Edits is a fashion and style publication covering outfit ideas, seasonal trends, and practical style guides for everyday wardrobes.';

async function getPostImage(post: any) {
  const content = (await post.entry.content()) as string;
  const match = content?.match(/!\[.*?\]\((.*?)\)/);
  return match?.[1]?.trim() || '/images/placeholder.jpg';
}

async function categoryImage(slug: string) {
  const posts = await getPostsByCategory(slug);
  return posts[0] ? getPostImage(posts[0]) : '/images/placeholder.jpg';
}

const [menImage, womenImage, trendsImage] = await Promise.all([
  categoryImage('men-s-fall-wardrobe'),
  categoryImage('women-s-fall-wardrobe'),
  categoryImage('trends'),
]);
const editor = await getAuthorBySlug('sara-khan');
const editorAvatar = editor?.avatar ? `/images/authors/${editor.avatar}` : '/images/authors/sara-profile.png';

const coverage = [
  { title: "Men's Style", description: 'Outfit ideas, seasonal dressing, shoes, denim, and everyday wardrobe inspiration.', href: '/category/men-s-fall-wardrobe/', image: menImage },
  { title: "Women's Style", description: 'Outfit inspiration, dresses, casual looks, workwear, and accessories.', href: '/category/women-s-fall-wardrobe/', image: womenImage },
  { title: 'Fashion Trends', description: 'Current trends, aesthetics, viral fashion moments, and seasonal style ideas.', href: '/category/trends/', image: trendsImage },
  { title: 'Style Guides', description: 'Practical styling advice, wardrobe guidance, outfit combinations, and fashion how-tos.', href: '/categories/', image: trendsImage },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Header currentPath="/about" />
  <main class="min-h-screen overflow-x-hidden bg-[#F8F6F2] text-neutral-900">
    <section class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-12 sm:px-6 md:py-20 lg:grid-cols-2 lg:px-8">
      <div>
        <p class="mb-4 text-[10px] font-bold uppercase tracking-[0.35em] text-[#bba15c]">About Outfit Edits</p>
        <h1 class="max-w-2xl font-serif text-4xl font-light leading-[1.05] text-neutral-950 sm:text-5xl md:text-7xl">About Outfit Edits</h1>
        <p class="mt-7 max-w-xl text-base font-light leading-relaxed text-neutral-600 md:text-lg">A fashion and style publication making fashion easier to understand, easier to wear, and more useful in everyday life.</p>
      </div>
      {editor && <div class="mx-auto w-full max-w-md bg-white p-2"><img src={editorAvatar} alt={editor.name} class="aspect-[4/5] h-full w-full object-cover object-top" onerror="this.onerror=null; this.src='/images/placeholder.jpg';" /></div>}
    </section>

    <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 md:pb-24">
      <div class="border-t border-neutral-200 pt-8 md:pt-12">
        <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.3em] text-[#bba15c]">Our Mission</p>
        <h2 class="font-serif text-3xl font-light text-neutral-950 md:text-4xl">Style advice for real wardrobes.</h2>
        <div class="mt-7 space-y-5 text-base font-light leading-relaxed text-neutral-600 md:text-lg">
          <p>Outfit Edits exists to make everyday dressing easier to understand, easier to experiment with, and more enjoyable.</p>
          <p>We publish outfit ideas, seasonal styling guides, trend coverage, and practical how-tos built around wearable ideas readers can adapt to their own style, occasion, and wardrobe.</p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 md:pb-24 lg:px-8">
      <div class="mb-8 border-t border-neutral-200 pt-8 md:mb-12 md:pt-12"><p class="mb-3 text-[10px] font-bold uppercase tracking-[0.3em] text-[#bba15c]">What We Cover</p><h2 class="font-serif text-3xl font-light text-neutral-950 md:text-4xl">Four ways into the archive.</h2></div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {coverage.map((item) => <a href={item.href} class="group relative aspect-[4/5] overflow-hidden bg-neutral-900 no-underline"><img src={item.image} alt={item.title} loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-80 transition-transform duration-500 group-hover:scale-105" onerror="this.onerror=null; this.src='/images/placeholder.jpg';" /><div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div><div class="absolute inset-x-0 bottom-0 p-5"><h3 class="font-serif text-xl font-light text-white">{item.title}</h3><p class="mt-2 text-xs font-light leading-relaxed text-white/75">{item.description}</p><span class="mt-4 inline-block border-b border-white/40 pb-1 text-[10px] uppercase tracking-[0.18em] text-white">Explore →</span></div></a>)}
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 md:pb-24">
      <div class="border-t border-neutral-200 pt-8 md:pt-12"><p class="mb-3 text-[10px] font-bold uppercase tracking-[0.3em] text-[#bba15c]">Our Approach</p><h2 class="font-serif text-3xl font-light text-neutral-950 md:text-4xl">Useful, wearable, and clear.</h2>
        <div class="mt-8 grid gap-7 sm:grid-cols-2"><div><h3 class="font-serif text-xl font-light">Wearable ideas</h3><p class="mt-2 text-sm font-light leading-relaxed text-neutral-500">Outfit inspiration designed to be practical for everyday wardrobes.</p></div><div><h3 class="font-serif text-xl font-light">Practical styling</h3><p class="mt-2 text-sm font-light leading-relaxed text-neutral-500">Clear guidance for combining pieces and approaching an occasion.</p></div><div><h3 class="font-serif text-xl font-light">Seasonal fashion</h3><p class="mt-2 text-sm font-light leading-relaxed text-neutral-500">Ideas that reflect changing seasons and the way people actually dress.</p></div><div><h3 class="font-serif text-xl font-light">Trend coverage</h3><p class="mt-2 text-sm font-light leading-relaxed text-neutral-500">Trend context that helps readers decide what fits their own style.</p></div></div>
      </div>
    </section>

    {editor && <section class="mx-auto max-w-4xl px-4 pb-20 sm:px-6 md:pb-28"><div class="flex flex-col gap-7 border border-neutral-200/70 bg-white p-6 md:flex-row md:items-center md:p-10"><img src={editorAvatar} alt={editor.name} class="h-28 w-28 shrink-0 rounded-full object-cover" onerror="this.onerror=null; this.src='/images/placeholder.jpg';" /><div><p class="mb-3 text-[10px] font-bold uppercase tracking-[0.3em] text-[#bba15c]">Meet the Editor</p><h2 class="font-serif text-3xl font-light text-neutral-950">{editor.name}</h2><p class="mt-4 text-sm font-light leading-relaxed text-neutral-600">{editor.bio}</p></div></div></section>}
  </main>
  <Footer />
</Layout>
